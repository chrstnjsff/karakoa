---
import { Image } from "astro:assets";
import photo from "../../assets/founder.jpg";
import SectionHeading from "../SectionHeading.astro";
import Icon from "../Icon.astro";
import type { IconName } from "../../data/site";

interface Props {
  founder: {
    eyebrow: string;
    name: string;
    role: string;
    photoAlt: string;
    bio: string;
    note: string;
    links: { label: string; href: string; icon: IconName }[];
    skills: string[];
  };
}
const { founder } = Astro.props;
---

<section id="founder" class="scroll-mt-20 border-t border-line/10 bg-surface/40" aria-labelledby="founder-title">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 lg:py-24">
    <SectionHeading eyebrow={founder.eyebrow} title="One senior engineer, start to finish" />
    <div class="reveal d1 card grid gap-8 p-6 sm:grid-cols-[minmax(0,15rem)_1fr] sm:p-8 lg:grid-cols-[15rem_1.2fr_0.8fr]">
      <Image
        src={photo}
        alt={founder.photoAlt}
        widths={[320, 480, 640]}
        sizes="(min-width: 640px) 15rem, calc(100vw - 5rem)"
        format="webp"
        loading="lazy"
        class="aspect-[4/5] w-full max-w-60 rounded-2xl object-cover"
      />
      <div>
        <h3 class="text-title3 font-semibold text-ink">{founder.name}</h3>
        <p class="mt-1 text-footnote font-semibold text-accent-text">{founder.role}</p>
        <p class="mt-4 text-body text-muted">{founder.bio}</p>
        <p class="mt-3 text-footnote text-muted">{founder.note}</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {
            founder.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                  class="btn btn-secondary press min-h-10 px-3.5 text-footnote"
                >
                  <Icon name={l.icon} class="h-4 w-4" />
                  {l.label}
                  <Icon name="external" class="h-3.5 w-3.5 text-muted" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="sm:col-start-2 lg:col-start-3">
        <p class="eyebrow">Works with</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {founder.skills.map((s) => <li class="chip">{s}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
