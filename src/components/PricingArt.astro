---
// 320 x 176 drawings for the pricing cards. Each loops on CSS keyframes,
// Base.astro pauses it off screen, and with reduced motion the base styles
// show one finished frame. All text is sample data.
interface Props {
  id: string;
}
const { id } = Astro.props;

// Eight teeth, so a 45 degree turn lands on the starting pose.
function gear(cx: number, cy: number, outer: number, inner: number, hole: number) {
  const pt = (deg: number, r: number) => {
    const a = (deg * Math.PI) / 180;
    return `${(cx + r * Math.cos(a)).toFixed(2)} ${(cy + r * Math.sin(a)).toFixed(2)}`;
  };
  let d = "";
  for (let i = 0; i < 8; i++) {
    const a = i * 45;
    d += `${i ? "L" : "M"}${pt(a - 16, inner)}L${pt(a - 9, outer)}L${pt(a + 9, outer)}L${pt(a + 16, inner)}`;
  }
  return `${d}ZM${cx + hole} ${cy}a${hole} ${hole} 0 1 0 ${-2 * hole} 0a${hole} ${hole} 0 1 0 ${2 * hole} 0Z`;
}

// A trace that repeats every 96 units, so three 32 unit steps loop seamlessly.
const trace = [106, 99, 102, 95, 100, 97];
const tracePts = Array.from({ length: 16 }, (_, k) => `${12 + k * 16} ${trace[k % 6]}`);
const traceLine = `M${tracePts.join("L")}`;
const traceArea = `${traceLine}L252 118L12 118Z`;

const wave = "M0 154C64 140 132 168 204 157S292 141 320 151V184H0Z";
