---
interface Props {
  idSuffix?: string;
}
const { idSuffix = "" } = Astro.props;
---

<div
  class="inline-flex items-center gap-0.5 rounded-full border border-line/12 p-0.5"
  role="group"
  aria-label="Colour theme"
  data-theme-switch
>
  <button
    type="button"
    data-theme-opt="system"
    id={`theme-system${idSuffix}`}
    class="theme-opt"
    title="System"
    aria-label="Match system theme"
    aria-pressed="false"
  >
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.7"></rect>
      <path d="M9 21h6M12 17v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
    </svg>
  </button>

  <button
    type="button"
    data-theme-opt="light"
    id={`theme-light${idSuffix}`}
    class="theme-opt"
    title="Light"
    aria-label="Light theme"
    aria-pressed="false"
  >
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"></circle>
      <path
        d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6L19 19M19 5l-1.4 1.4M6.4 17.6L5 19"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"></path>
    </svg>
  </button>

  <button
    type="button"
    data-theme-opt="dark"
    id={`theme-dark${idSuffix}`}
    class="theme-opt"
    title="Dark"
    aria-label="Dark theme"
    aria-pressed="false"
  >
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M20 13.6A8 8 0 1 1 10.4 4a6.2 6.2 0 0 0 9.6 9.6z"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"></path>
    </svg>
  </button>
</div>
