# Cloudflare Workers static asset headers (not served itself).
# Astro puts a content hash in every /_astro/ file name, so a changed file
# gets a new URL and these can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers on every response. HTTPS itself is forced by the
# Cloudflare zone setting "Always Use HTTPS".
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
