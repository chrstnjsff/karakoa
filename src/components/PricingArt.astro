          {["Backups", "Updates", "Uptime"].map((label, i) => (
            <g>
              {i < 2 && (
                <>
                  <circle cx="18" cy={40 + i * 16} r="5.5" fill="#3cc4bf" />
                  <path d={`M15.4 ${40 + i * 16}l1.8 1.8 3.4-3.6`} fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
