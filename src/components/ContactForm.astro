---
// Posts to the Worker at /api/contact (worker/index.ts). Without script the
// form still posts and the Worker answers with a page.
import Icon from "./Icon.astro";
import { TURNSTILE_SITE_KEY, contact } from "../data/site";
---

<div id="message" class="scroll-mt-24">
  <form
    action="/api/contact"
    method="POST"
    class="msg rounded-xl bg-paper p-5 sm:p-7"
    aria-labelledby="msg-title"
    aria-describedby="msg-privacy"
    data-contact
    data-sitekey={TURNSTILE_SITE_KEY}
  >
    <!-- honeypot: people never see or fill it, bots do -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" aria-hidden="true" />

    <h3 id="msg-title" class="text-[22px] font-semibold tracking-[-0.01em]">{contact.formTitle}</h3>
    <p class="mt-1.5 text-[15px] text-muted">{contact.formLede}</p>

    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for="msg-name" class="f-label">Name</label>
        <input id="msg-name" name="name" type="text" autocomplete="name" required maxlength="100" class="f-in" aria-describedby="msg-name-error" />
        <p id="msg-name-error" class="f-err" hidden></p>
      </div>
      <div>
        <label for="msg-email" class="f-label">Email</label>
        <input
          id="msg-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          spellcheck="false"
          required
          maxlength="254"
          class="f-in"
          aria-describedby="msg-email-error"
        />
        <p id="msg-email-error" class="f-err" hidden></p>
      </div>
    </div>

    <div class="mt-5">
      <label for="msg-type" class="f-label">Project type</label>
      <div class="relative">
        <select id="msg-type" name="service" required class="f-in" aria-describedby="msg-type-error">
          <option value="">Choose one</option>
          {contact.projectTypes.map((t) => <option>{t}</option>)}
        </select>
        <svg viewBox="0 0 24 24" fill="none" class="pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted" aria-hidden="true">
          <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <p id="msg-type-error" class="f-err" hidden></p>
    </div>

    <div class="mt-5">
      <label for="msg-body" class="f-label">Message</label>
      <textarea
        id="msg-body"
        name="message"
        rows="5"
        required
        minlength="10"
        maxlength="5000"
        class="f-in"
        placeholder={contact.messagePlaceholder}
        aria-describedby="msg-body-error"></textarea>
      <p id="msg-body-error" class="f-err" hidden></p>
    </div>

    <!-- Turnstile stays invisible unless Cloudflare needs the visitor to click -->
    <div class="mt-5 empty:hidden" data-turnstile></div>

    <div class="f-alert" role="alert" data-alert></div>

    <div class="mt-6 flex flex-col-reverse gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p id="msg-privacy" class="text-[13px] leading-snug text-muted">
        {contact.privacy} <a href="/privacy/" class="text-navy underline underline-offset-2">Privacy</a>
      </p>
      <button type="submit" class="btn-primary shrink-0" data-submit>
        <Icon name="mail" class="size-4" /><span data-label>Send message</span>
      </button>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-status></p>
  </form>

  <div class="msg rounded-xl bg-paper p-5 sm:p-7" hidden data-success>
    <span class="inline-grid size-9 place-items-center rounded-full bg-[#dcf3ef] text-[#13665b]"><Icon name="check" class="size-4" /></span>
    <h3 tabindex="-1" class="mt-4 text-[22px] font-semibold tracking-[-0.01em] outline-none" data-success-heading>Message sent</h3>
    <p class="mt-2 text-[15px] leading-relaxed" data-success-text>
      Thanks for reaching out. We reply to the email address you gave within one working day.
    </p>
    <button type="button" class="btn-ghost mt-6" data-send-another>Send another message</button>
  </div>
</div>

<style is:global>
  .msg {
    color: #3d4a54;
  }
  .msg :focus-visible {
    outline-color: var(--color-navy);
  }
  .msg .f-label {
    display: block;
    margin-bottom: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-navy);
  }
  .msg .f-in {
    width: 100%;
    height: 44px;
    padding: 0 12px;
    border: 1px solid #d9d2c6;
    border-radius: 6px;
    background: #fff;
    font-size: 16px;
    color: var(--color-navy);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .msg textarea.f-in {
    height: auto;
    min-height: 128px;
    padding: 10px 12px;
    line-height: 1.5;
    resize: vertical;
  }
  .msg select.f-in {
    appearance: none;
    padding-right: 38px;
    text-overflow: ellipsis;
    cursor: pointer;
  }
  .msg select.f-in:invalid {
    color: #6b747c;
  }
  .msg .f-in::placeholder {
    color: #6b747c;
  }
  .msg .f-in:hover {
    border-color: #bfb6a8;
  }
  .msg .f-in:focus {
    outline: none;
    border-color: var(--color-navy);
    box-shadow: 0 0 0 3px rgba(11, 44, 68, 0.12);
  }
  .msg .f-in[aria-invalid="true"] {
    border-color: var(--color-coral-700);
  }
  .msg .f-err {
    margin-top: 6px;
    font-size: 13px;
    color: var(--color-coral-700);
  }
  .msg .f-alert:empty {
    display: none;
  }
  .msg .f-alert {
    margin-top: 18px;
    padding: 10px 12px;
    border-radius: 6px;
    background: #fbeae5;
    font-size: 14px;
    color: #8f2c14;
  }
  .msg .f-alert a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .msg [data-submit][aria-busy] {
    opacity: 0.75;
    cursor: progress;
  }
</style>

<script>
  import "../scripts/contact.ts";
</script>
