---
// Index of the student guides. Content lives in src/content/guides.
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { SITE, calendlyUrl } from "../../data/site";

const guides = (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order);
const title = "Capstone and Thesis Guides for Students | Karakoa";
const description =
  "Free guides for Philippine IT and computer science students: choosing a capstone title, writing chapters 1 to 5, defense questions, a two-semester timeline, and getting help.";

const listLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE.url}/guides/#page`,
  url: `${SITE.url}/guides/`,
  name: title,
  description,
  isPartOf: { "@id": `${SITE.url}/#website` },
  hasPart: guides.map((g) => ({ "@type": "Article", headline: g.data.title, url: `${SITE.url}/guides/${g.id}/` })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
    { "@type": "ListItem", position: 2, name: "Guides", item: `${SITE.url}/guides/` },
  ],
};

const fmt = new Intl.DateTimeFormat("en-PH", { year: "numeric", month: "long", day: "numeric" });
---

<Base title={title} description={description} ogImage="/og/guides.png" jsonLd={[listLd, breadcrumbLd]}>
  <div class="mx-auto max-w-6xl px-5 pb-16 sm:px-6 lg:pb-24">
    <header class="max-w-3xl pb-10 pt-12 sm:pt-20">
      <p class="eyebrow">Guides</p>
      <h1 class="mt-4 text-title2 font-semibold text-ink xs:text-title1 sm:text-large">Capstone and thesis guides</h1>
      <p class="mt-5 text-callout text-muted">
        Practical guides for BSIT, BSIS, BSCS, and BSCpE students in the Philippines, written from the systems we build
        and the defenses we prepare students for. No sign-up, no fluff.
      </p>
    </header>

    <ol class="grid gap-4 md:grid-cols-2">
      {
        guides.map((g, i) => (
          <li class={`reveal d${(i % 4) + 1} card card-lift flex flex-col p-6`}>
            <p class="eyebrow text-caption">{g.data.audience}</p>
            <h2 class="mt-3 text-title3 font-semibold text-ink">
              <a href={`/guides/${g.id}/`} class="link-ul">
                {g.data.title}
              </a>
            </h2>
            <p class="mt-3 text-body text-muted">{g.data.summary}</p>
            <p class="mt-auto pt-5 text-caption text-muted">Updated {fmt.format(g.data.updated)}</p>
            <a
              href={`/guides/${g.id}/`}
              class="mt-3 inline-flex min-h-10 items-center gap-1 text-footnote font-semibold text-accent-text"
            >
              Read the guide
              <Icon name="arrow" class="h-3.5 w-3.5" />
            </a>
          </li>
        ))
      }
    </ol>

    <section class="card mt-14 p-6 sm:p-8" aria-labelledby="cta-title">
      <h2 id="cta-title" class="text-title3 font-semibold text-ink">Need the system built, not just the guide?</h2>
      <p class="mt-2 text-body text-muted">
        We build capstone and thesis systems with consultation, documentation support, and a full walkthrough before
        your defense.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/services/capstone-thesis-system/" class="btn btn-primary press">
          Capstone and thesis systems
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href={calendlyUrl} target="_blank" rel="noopener" class="btn btn-secondary press">Book a call</a>
      </div>
    </section>
  </div>
</Base>
