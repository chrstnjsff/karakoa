---
import "@fontsource-variable/roboto";
import robotoLatin from "@fontsource-variable/roboto/files/roboto-latin-wght-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Logo from "../components/Logo.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageSky from "../components/PageSky.astro";
import { SITE, NAV, PAGES } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Root-relative share image; defaults to the site-wide card. */
  ogImage?: string;
  /** Keep utility pages (e.g. the form thank-you page) out of search. */
  noindex?: boolean;
  /** Structured data blocks, each emitted as its own JSON-LD script. */
  jsonLd?: object[];
  /** CSS generated at build time for this page (the work screens' keyframes). */
  headStyle?: string;
}

const { title, description, ogImage = "/og.png", noindex = false, jsonLd = [], headStyle } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const isHome = Astro.url.pathname === "/";
const link = (href: string) => (isHome || !href.startsWith("#") ? href : `/${href}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b2c44" />
    <link rel="preload" href={robotoLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline>
      // Lets CSS hide scroll-reveal content only when JS will show it.
      document.documentElement.classList.add("js");
    </script>

    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    {headStyle && <style is:inline set:html={headStyle} />}
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[80] focus:rounded-md focus:bg-paper focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-navy"
    >
      Skip to content
    </a>

    <div id="top"></div>
    <PageSky />
    <Header />

    <div
      id="mobileNav"
      role="dialog"
      aria-modal="true"
      aria-label="Menu"
      class="on-dark fixed inset-0 z-[60] hidden flex-col bg-navy text-foam md:hidden"
    >
      <div class="flex h-16 shrink-0 items-center justify-between border-b border-white/10 px-5">
        <a
          href={isHome ? "#top" : "/"}
          class="flex min-h-11 items-center"
          aria-label={isHome ? `${SITE.domain}, back to top` : `${SITE.domain}, home`}
        >
          <Logo mascotId="menu" onDark />
        </a>
        <button
          type="button"
          id="mobile-nav-close"
          class="-mr-2.5 grid size-11 place-items-center rounded-md text-foam"
          aria-label="Close menu"
        >
          <svg viewBox="0 0 24 24" fill="none" class="size-5" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 pt-2 pb-10">
        <nav aria-label="Primary, mobile">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={link(item.href)} class="flex min-h-14 items-center border-b border-white/10 text-[22px] font-medium text-white">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <ul class="mt-6 flex flex-wrap gap-x-6">
            {
              PAGES.map((item) => (
                <li>
                  <a href={item.href} class="inline-flex min-h-11 items-center text-[17px] text-mist">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a href={link("#message")} data-msg class="btn-primary mt-8 w-full">Send a message</a>
      </div>
    </div>

    <main id="main" class="relative flex min-h-[calc(100dvh-4rem)] flex-col" data-inert-when-menu>
      <div class="flex-1">
        <slot />
      </div>
      <SiteFooter />
    </main>

    <script is:inline>
      (function () {
        var panel = document.getElementById("mobileNav");
        var openBtn = document.getElementById("mobile-nav-open");
        var closeBtn = document.getElementById("mobile-nav-close");
        if (!panel || !openBtn || !closeBtn) return;
        var background = document.querySelectorAll("[data-inert-when-menu]");

        function isOpen() {
          return !panel.classList.contains("hidden");
        }

        function focusables() {
          return Array.prototype.filter.call(
            panel.querySelectorAll("a[href], button:not([disabled])"),
            function (el) {
              return el.getClientRects().length > 0;
            }
          );
        }

        function setBackgroundInert(value) {
          background.forEach(function (el) {
            el.inert = value;
          });
        }

        function open() {
          panel.classList.remove("hidden");
          panel.classList.add("flex");
          openBtn.setAttribute("aria-expanded", "true");
          document.body.style.overflow = "hidden";
          setBackgroundInert(true);
          closeBtn.focus();
        }

        // restoreFocus is false when a link inside the menu navigates,
        // so focus follows the link target instead of the menu button.
        function close(restoreFocus) {
          panel.classList.add("hidden");
          panel.classList.remove("flex");
          openBtn.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
          setBackgroundInert(false);
          if (restoreFocus !== false) openBtn.focus();
        }

        openBtn.addEventListener("click", open);
        closeBtn.addEventListener("click", function () {
          close();
        });
        panel.querySelectorAll("a").forEach(function (a) {
          a.addEventListener("click", function () {
            close(false);
          });
        });
        document.addEventListener("keydown", function (e) {
          if (!isOpen()) return;
          if (e.key === "Escape") {
            close();
            return;
          }
          if (e.key !== "Tab") return;
          var items = focusables();
          if (!items.length) return;
          var first = items[0];
          var last = items[items.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        });

        // The menu only exists below md; growing the window past it must
        // not leave the page inert behind an invisible dialog.
        window.matchMedia("(min-width: 768px)").addEventListener("change", function (e) {
          if (e.matches && isOpen()) close(false);
        });
      })();

      // Items that enter together stagger by 70ms, unless a d1 to d4 class
      // already sets their delay.
      (function () {
        var items = document.querySelectorAll(".reveal");
        if (!items.length) return;

        if (
          window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !("IntersectionObserver" in window)
        ) {
          items.forEach(function (el) {
            el.classList.add("in");
          });
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            var n = 0;
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              if (!/\bd[1-4]\b/.test(el.className)) el.style.setProperty("--stagger", n++ * 70 + "ms");
              el.classList.add("in");
              io.unobserve(el);
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0 }
        );

        items.forEach(function (el) {
          io.observe(el);
        });
      })();

      // Anything marked data-loop pauses its CSS and SVG animations while unseen.
      (function () {
        var loops = document.querySelectorAll("[data-loop]");
        if (!loops.length || !("IntersectionObserver" in window)) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            var el = entry.target;
            el.classList.toggle("idle", !entry.isIntersecting);
            el.querySelectorAll("svg").forEach(function (svg) {
              if (!svg.pauseAnimations) return;
              if (entry.isIntersecting) svg.unpauseAnimations();
              else svg.pauseAnimations();
            });
          });
        });
        loops.forEach(function (el) {
          io.observe(el);
        });
        document.addEventListener("visibilitychange", function () {
          document.documentElement.classList.toggle("tab-hidden", document.hidden);
        });
      })();

      (function () {
        var links = document.querySelectorAll("[data-spy]");
        if (!links.length || !("IntersectionObserver" in window)) return;

        var map = {};
        links.forEach(function (a) {
          var href = a.getAttribute("href") || "";
          if (href.charAt(0) !== "#") return;
          var id = decodeURIComponent(href.slice(1));
          if (id) (map[id] = map[id] || []).push(a);
        });

        var current = null;
        function activate(id) {
          if (id === current) return;
          current = id;
          links.forEach(function (a) {
            a.removeAttribute("aria-current");
          });
          (map[id] || []).forEach(function (a) {
            a.setAttribute("aria-current", "true");
          });
        }

        // A section leaving the band clears its link, so the hero and the
        // sections without a nav link light nothing.
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) activate(entry.target.id);
              else if (entry.target.id === current) activate(null);
            });
          },
          { rootMargin: "-35% 0px -55% 0px", threshold: 0 }
        );

        Object.keys(map).forEach(function (id) {
          var el = document.getElementById(id);
          if (el) io.observe(el);
        });
      })();
    </script>
  </body>
</html>
