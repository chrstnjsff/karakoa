---
// Landing page for the no-JavaScript form path: the Worker redirects
// here after a successful submission. Kept out of search and the sitemap.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { SITE, calendlyUrl, contact, whatsappUrl } from "../../data/site";
---

<Base
  title={`${contact.success.title} · ${SITE.name}`}
  description="Your message was sent. Thanks for getting in touch."
  noindex
>
  <div class="mx-auto max-w-2xl px-5 pb-16 sm:px-6">
    <header class="pb-10 pt-14 sm:pt-20">
      <p class="reveal eyebrow">Sent</p>
      <h1 class="reveal d1 mt-4 text-title2 font-semibold text-ink xs:text-title1 sm:text-large">{contact.success.title}</h1>
      <p class="reveal d2 mt-4 max-w-xl text-callout text-muted">{contact.success.textPlain}</p>
      <p class="reveal d2 mt-2 max-w-xl text-callout text-muted">{contact.success.next}</p>
      <div class="reveal d3 mt-8 flex flex-wrap items-center gap-3">
        <a class="btn-primary w-full sm:w-auto" target="_blank" rel="noopener" href={`${whatsappUrl}?text=${encodeURIComponent(contact.success.whatsappText())}`}>
          {contact.success.whatsapp}<Icon name="arrow" class="size-4" /><span class="sr-only"> {contact.success.whatsappNote}</span>
        </a>
        <a class="btn-ghost w-full sm:w-auto" target="_blank" rel="noopener" href={calendlyUrl}>
          <Icon name="calendar" class="size-4" />{contact.success.call}<span class="sr-only"> {contact.success.callNote}</span>
        </a>
        <a href="/" class="btn-link min-h-11">Back to home</a>
      </div>
    </header>
  </div>
</Base>
