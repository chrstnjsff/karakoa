---
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import photo from "../assets/founder.jpg";
import Hero from "../components/sections/Hero.astro";
import ToolsStrip from "../components/sections/ToolsStrip.astro";
import Services from "../components/sections/Services.astro";
import Process from "../components/sections/Process.astro";
import TrackRecord from "../components/sections/TrackRecord.astro";
import Work from "../components/sections/Work.astro";
import About from "../components/sections/About.astro";
import Pricing from "../components/sections/Pricing.astro";
import NameStrip from "../components/sections/NameStrip.astro";
import Contact from "../components/sections/Contact.astro";
import { SITE, founder, services } from "../data/site";
import { workKeyframes } from "../lib/work-shots";

const title = "Software Development Company in the Philippines | Karakoa";
const founderPhotoUrl = new URL((await getImage({ src: photo, width: 800, format: "jpeg" })).src, SITE.url).href;

const organization = {
  "@context": "https://schema.org",
  "@type": ["ProfessionalService", "Organization"],
  "@id": `${SITE.url}/#organization`,
  name: SITE.name,
  url: `${SITE.url}/`,
  logo: { "@type": "ImageObject", url: `${SITE.url}/apple-touch-icon.png`, width: 180, height: 180 },
  image: `${SITE.url}/og.png`,
  description: SITE.description,
  email: SITE.email,
  priceRange: "PHP",
  currenciesAccepted: "PHP, USD",
  foundingDate: String(SITE.founded),
  founder: {
    "@type": "Person",
    "@id": `${SITE.url}/#founder`,
    name: founder.name,
    jobTitle: founder.role,
    image: founderPhotoUrl,
    url: founder.links[0].href,
    sameAs: founder.links.slice(1).map((l) => l.href),
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.location.locality,
    addressRegion: SITE.location.region,
    addressCountry: SITE.location.country,
  },
  areaServed: [{ "@type": "Country", name: "Philippines" }, { "@type": "Place", name: "Worldwide (remote)" }],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "14:00",
      closes: "21:00",
    },
  ],
  knowsAbout: services.map((s) => s.title),
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Services",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: s.title, url: `${SITE.url}/services/${s.slug}/` },
    })),
  },
  sameAs: [SITE.githubUrl, ...founder.links.slice(1).map((l) => l.href)],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE.url}/#website`,
  url: `${SITE.url}/`,
  name: SITE.name,
  publisher: { "@id": `${SITE.url}/#organization` },
};
---

<Base title={title} ogImage="/og/home.png" description={SITE.description} jsonLd={[organization, website]} headStyle={workKeyframes}>
  <Hero />
  <ToolsStrip />
  <Services />
  <Process />
  <TrackRecord />
  <Work />
  <About />
  <Pricing />
  <NameStrip />
  <Contact />
</Base>
