---
import SectionHeading from "../SectionHeading.astro";
import ContactForm from "../ContactForm.astro";
import ContactChannels from "../ContactChannels.astro";
import type { Channel } from "../../data/site";

interface Props {
  contact: { eyebrow: string; title: string; lede: string };
  channels: Channel[];
  hours: string;
}
const { contact, channels, hours } = Astro.props;
---

<section id="contact" class="scroll-mt-20 border-t border-line/10 bg-surface/40" aria-labelledby="contact-title">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 lg:py-24">
    <SectionHeading eyebrow={contact.eyebrow} title={contact.title} lede={contact.lede} />
    <div class="grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:gap-12">
      <ContactForm />
      <div class="reveal d3">
        <h3 class="eyebrow">Or reach us directly</h3>
        <div class="mt-3">
          <ContactChannels channels={channels} />
        </div>
        <p class="mt-4 text-caption text-muted">Replies and calls: {hours}.</p>
      </div>
    </div>
  </div>
</section>
