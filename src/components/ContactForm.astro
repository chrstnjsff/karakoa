---
// Web3Forms inquiry form, progressively enhanced:
// - Without JS it is a plain HTML POST; Web3Forms answers with a 303
//   to /contact/thanks/ (the `redirect` field, same-domain on the free plan).
// - With JS (src/scripts/contact.ts) it validates inline, posts JSON,
//   and swaps in a success panel without leaving the page.
import { SITE, WEB3FORMS_ACCESS_KEY, contact } from "../data/site";

const redirect = new URL("/contact/thanks/", SITE.url).href;
---

<div class="reveal d2">
  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    class="card p-5 sm:p-7"
    data-contact
    aria-describedby="contact-privacy"
  >
    <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
    <input type="hidden" name="subject" value={`New inquiry from ${SITE.domain}`} />
    <input type="hidden" name="from_name" value={SITE.domain} />
    <input type="hidden" name="redirect" value={redirect} />
    <!-- honeypot: people never see or fill it, bots do -->
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      style="display: none"
      tabindex="-1"
      aria-hidden="true"
    />

    <h3 class="text-title3 font-semibold text-ink">{contact.formTitle}</h3>

    <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for="contact-name" class="field-label">Name</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          maxlength="100"
          class="field-input"
          aria-describedby="contact-name-error"
        />
        <p id="contact-name-error" class="field-error" hidden></p>
      </div>
      <div>
        <label for="contact-email" class="field-label">Email</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          spellcheck="false"
          required
          maxlength="254"
          class="field-input"
          aria-describedby="contact-email-error"
        />
        <p id="contact-email-error" class="field-error" hidden></p>
      </div>
    </div>

    <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for="contact-service" class="field-label">What do you need?</label>
        <div class="relative">
          <select id="contact-service" name="service" class="field-input field-select">
            {contact.services.map((s) => <option value={s}>{s}</option>)}
          </select>
          <svg viewBox="0 0 24 24" fill="none" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>
      <div>
        <label for="contact-scale" class="field-label">Project size</label>
        <div class="relative">
          <select id="contact-scale" name="scale" class="field-input field-select">
            {contact.scales.map((s) => <option value={s}>{s}</option>)}
          </select>
          <svg viewBox="0 0 24 24" fill="none" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="mt-5">
      <label for="contact-timeline" class="field-label">
        Deadline or timeline <span class="font-normal text-muted">(optional)</span>
      </label>
      <input
        id="contact-timeline"
        name="timeline"
        type="text"
        maxlength="120"
        class="field-input"
        placeholder="e.g. defense in March, launch before December"
      />
    </div>

    <div class="mt-5">
      <label for="contact-message" class="field-label">Tell us about the project</label>
      <textarea
        id="contact-message"
        name="message"
        rows="6"
        required
        minlength="10"
        maxlength="5000"
        spellcheck="true"
        class="field-input field-textarea"
        placeholder="What it is, who it is for, what is blocking you, and what success looks like."
        aria-describedby="contact-message-error"></textarea>
      <p id="contact-message-error" class="field-error" hidden></p>
    </div>

    <div class="contact-alert mt-5" role="alert" id="contact-alert"></div>

    <div class="mt-6 flex flex-col-reverse gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p id="contact-privacy" class="text-caption text-muted">
        Delivered by Web3Forms. Your details are only used to reply to you.{" "}
        <a href="/privacy/" class="link-ul text-ink">Privacy</a>
      </p>
      <button type="submit" class="btn btn-primary press shrink-0" data-submit>Send project inquiry</button>
    </div>
    <p class="sr-only" role="status" aria-live="polite" id="contact-status"></p>
  </form>

  <div id="contact-success" class="card p-5 sm:p-7" hidden>
    <p class="eyebrow">Sent</p>
    <h3 class="mt-3 text-title3 font-semibold text-ink outline-none" tabindex="-1" data-success-heading>
      Inquiry sent
    </h3>
    <p class="mt-3 text-body text-muted" data-success-text>
      Thanks for reaching out. We reply to the email address you gave within one working day.
    </p>
    <button type="button" class="btn btn-secondary press mt-6" data-send-another>Send another inquiry</button>
  </div>
</div>

<script>
  import "../scripts/contact.ts";
</script>
