---
// One page per service, driven by services[] in src/data/site.ts, so each
// service has its own title, description, H1, FAQ, and Service schema.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import { SITE, services, calendlyUrl, hours } from "../../data/site";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const pageUrl = `${SITE.url}/services/${service.slug}/`;
const others = services.filter((s) => s.id !== service.id);
const guides =
  service.id === "capstone" ? (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order) : [];

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: service.title,
  serviceType: service.title,
  description: service.seoDescription,
  url: pageUrl,
  provider: { "@id": `${SITE.url}/#organization` },
  areaServed: [{ "@type": "Country", name: "Philippines" }, { "@type": "Place", name: "Worldwide (remote)" }],
  ...(service.id === "capstone"
    ? { audience: { "@type": "EducationalAudience", educationalRole: "student" } }
    : {}),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
    { "@type": "ListItem", position: 2, name: "Services", item: `${SITE.url}/#services` },
    { "@type": "ListItem", position: 3, name: service.title, item: pageUrl },
  ],
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  isPartOf: { "@id": `${SITE.url}/#website` },
  mainEntity: service.faq.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
---

<Base
  title={service.seoTitle}
  description={service.seoDescription}
  ogImage={`/og/service-${service.slug}.png`} jsonLd={[serviceLd, breadcrumbLd, faqLd]}>
  <article class="mx-auto max-w-6xl px-5 pb-16 sm:px-6 lg:pb-24">
    <nav aria-label="Breadcrumb" class="pt-8 text-footnote text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="link-ul">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/#services" class="link-ul">Services</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ink" aria-current="page">{service.title}</li>
      </ol>
    </nav>

    <header class="grid gap-8 pb-12 pt-8 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16 lg:pt-12">
      <div>
        <span class="grid h-12 w-12 place-items-center rounded-xl bg-accent/12 text-accent-text">
          <Icon name={service.icon} class="h-6 w-6" />
        </span>
        <h1 class="mt-5 text-title2 font-semibold text-ink xs:text-title1 sm:text-large">{service.heading}</h1>
        {service.intro.map((p) => <p class="mt-5 text-callout text-muted">{p}</p>)}
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/#contact" class="btn btn-primary press">
            Start a project
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href={calendlyUrl} target="_blank" rel="noopener" class="btn btn-secondary press">Book a call</a>
        </div>
      </div>
      <aside class="card self-start p-6">
        <h2 class="eyebrow">What is included</h2>
        <ul class="mt-3 space-y-2 text-body text-ink">
          {
            service.includes.map((b) => (
              <li class="flex gap-2">
                <Icon name="check" class="mt-1.5 h-4 w-4 shrink-0 text-teal-text" />
                <span>{b}</span>
              </li>
            ))
          }
        </ul>
        <h2 class="eyebrow mt-6">Typical stack</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {service.stack.map((s) => <li class="chip">{s}</li>)}
        </ul>
        <p class="mt-6 text-caption text-muted">Replies and calls: {hours}.</p>
      </aside>
    </header>

    <section class="border-t border-line/10 py-12" aria-labelledby="examples-title">
      <h2 id="examples-title" class="text-title2 font-semibold text-ink">What we build under this service</h2>
      <p class="mt-2 text-body text-muted">Kinds of systems only; we do not publish client names.</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          service.examples.map((e) => (
            <li class="card flex items-center gap-3 p-4 text-body text-ink">
              <Icon name="check" class="h-4 w-4 shrink-0 text-teal-text" />
              {e}
            </li>
          ))
        }
      </ul>
    </section>

    {
      guides.length > 0 && (
        <section class="border-t border-line/10 py-12" aria-labelledby="guides-title">
          <h2 id="guides-title" class="text-title2 font-semibold text-ink">Free guides for students</h2>
          <p class="mt-2 text-body text-muted">What we tell every student before the first call.</p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {guides.map((g) => (
              <li>
                <a href={`/guides/${g.id}/`} class="card card-lift block p-4">
                  <span class="block text-body font-semibold text-ink">{g.data.title}</span>
                  <span class="mt-1 block text-footnote text-muted">{g.data.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="border-t border-line/10 py-12" aria-labelledby="faq-title">
      <h2 id="faq-title" class="text-title2 font-semibold text-ink">Questions about this service</h2>
      <div class="mt-6 max-w-3xl divide-y divide-line/10 border-y border-line/10">
        {
          service.faq.map((item) => (
            <details class="disclosure">
              <summary class="flex min-h-12 items-center justify-between gap-4 py-3 text-body font-semibold text-ink">
                <span>{item.q}</span>
                <svg viewBox="0 0 24 24" fill="none" class="disclosure-chevron h-4 w-4 shrink-0 text-muted" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <p class="pb-4 pr-8 text-body text-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="border-t border-line/10 py-12" aria-labelledby="other-title">
      <h2 id="other-title" class="eyebrow">Other services</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          others.map((o) => (
            <li>
              <a href={`/services/${o.slug}/`} class="btn btn-secondary press min-h-10 px-3.5 text-footnote">
                {o.title}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="card p-6 sm:p-8" aria-labelledby="cta-title">
      <h2 id="cta-title" class="text-title3 font-semibold text-ink">Tell us what you are building</h2>
      <p class="mt-2 text-body text-muted">
        Share the product, the deadline, and what is blocking you. You get a reply within one working day with a
        recommended way to start.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/#contact" class="btn btn-primary press">Send an inquiry</a>
        <a href={`mailto:${SITE.email}`} class="btn btn-secondary press">{SITE.email}</a>
      </div>
    </section>
  </article>
</Base>
