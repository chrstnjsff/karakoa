---
import { Image } from "astro:assets";
import photo from "../../assets/founder.jpg";
import Sky from "../Sky.astro";
import Icon from "../Icon.astro";
import Figure from "../Figure.astro";
import { aboutSection, calendlyUrl, founder } from "../../data/site";

const last = aboutSection.career.length - 1;
---

<section id="about" class="border-t border-line" aria-labelledby="about-title">
  <div class="mx-auto grid max-w-6xl items-start gap-12 px-5 py-24 sm:py-32 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <figure class="reveal on-dark relative mx-auto w-full max-w-md overflow-hidden rounded-2xl bg-navy p-3 sm:p-4 lg:sticky lg:top-24">
      <Sky class="inset-0 h-full w-full" seed={64} h={1200} count={60} />
      <Image
        src={photo}
        alt={founder.photoAlt}
        widths={[400, 600, 800]}
        sizes="(min-width: 1024px) 400px, (min-width: 448px) 416px, calc(100vw - 64px)"
        format="webp"
        loading="lazy"
        class="relative block aspect-[4/5] w-full rounded-xl object-cover object-[50%_30%]"
      />
      <figcaption class="relative px-1.5 pt-4 pb-1.5">
        <span class="block text-lg leading-snug font-semibold text-white">{founder.name}</span>
        <span class="block text-[15px] text-mist">{founder.role}, {founder.place}</span>
        <span class="mt-3 flex items-center gap-2 text-sm text-foam">
          <span class="avail-dot relative size-1.5 rounded-full bg-mist" data-avail-dot></span>
          <span data-avail>Calls Mon to Fri, 2 PM to 9 PM, Philippine time</span>
        </span>
      </figcaption>
    </figure>

    <div>
      <div class="reveal">
        <p class="label">{aboutSection.eyebrow}</p>
        <h2 id="about-title" class="h2 mt-3">{aboutSection.title}</h2>
        {aboutSection.intro.map((p, i) => <p class:list={["lead", i ? "mt-4" : "mt-5"]}>{p}</p>)}
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={calendlyUrl} target="_blank" rel="noopener" class="btn-primary">
            <Icon name="calendar" class="size-4" />{aboutSection.book}<span class="sr-only"> (opens Calendly in a new tab)</span>
          </a>
          <a href={founder.resumeUrl} class="btn-ghost">{aboutSection.resume} <Icon name="arrow" class="size-4" /></a>
        </div>
      </div>

      <dl class="reveal about-nums mt-14 grid gap-y-5 sm:grid-cols-3 sm:gap-x-8">
        {
          aboutSection.numbers.map((n) => (
            <div class="flex flex-col border-t border-line pt-5">
              <dt class="order-2 mt-3 text-[15px] leading-snug">{n.label}</dt>
              <dd class="order-1 text-[34px] leading-none font-medium tracking-[-0.03em] text-navy tabular-nums sm:text-[44px]">
                <Figure figure={n} suffixClass="text-coral-600" />
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="reveal mt-14">
        <h3 class="text-[15px] font-medium text-navy">{aboutSection.courseTitle}</h3>
        <ol class="career mt-5" data-career>
          {
            aboutSection.career.map((c, i) => (
              <li class:list={{ now: i === last }} style={`--i:${i}`}>
                <span class="yr">{c.year}</span>
                <b>{c.role}</b>
              </li>
            ))
          }
        </ol>
        <p class="mt-6 text-sm text-muted">{aboutSection.certNote}</p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
          {
            founder.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex min-h-9 items-center gap-1.5 font-medium text-coral-700 underline-offset-4 hover:underline"
                >
                  <Icon name={l.icon} class="size-4" />
                  {l.label}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .avail-dot.is-open {
    background: var(--color-gold);
    color: var(--color-gold);
  }
  .avail-dot.is-open::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.3;
    animation: beacon 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .career {
    position: relative;
    display: grid;
    gap: 14px;
    padding-left: 30px;
  }
  .career li {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr;
    column-gap: 12px;
    --at: calc(0.15s + var(--i) * 0.26s);
  }
  .career li::before {
    content: "";
    position: absolute;
    top: 5px;
    left: -30px;
    width: 13px;
    height: 13px;
    border: 1.5px solid rgba(11, 44, 68, 0.4);
    border-radius: 99px;
    background: #f8f6f2;
    transition:
      background 0.4s var(--at),
      border-color 0.4s var(--at);
  }
  .career li:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 20px;
    bottom: -17px;
    left: -24px;
    border-left: 1.5px dashed rgba(212, 66, 31, 0.6);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.35s ease-out var(--at);
  }
  .career.on li::before,
  html:not(.js) .career li::before {
    border-color: #0b2c44;
    background: #0b2c44;
  }
  .career.on li::after,
  html:not(.js) .career li::after {
    transform: none;
  }
  .career li.now::before {
    border-color: #d4421f;
    background: #d4421f;
    box-shadow: 0 0 0 4px rgba(212, 66, 31, 0.15);
  }
  .career .yr {
    font-size: 15px;
    color: #5f6b75;
    font-variant-numeric: tabular-nums;
  }
  .career b {
    font-size: 16px;
    font-weight: 500;
    color: #0b2c44;
  }
  .career li.now b {
    color: #b9381a;
  }
  @media (max-width: 639px) {
    .about-nums > div {
      display: grid;
      grid-template-columns: 118px 1fr;
      align-items: baseline;
      column-gap: 14px;
    }
    .about-nums dt {
      margin-top: 0;
    }
  }
</style>

<script>
  import "../../scripts/clock.ts";

  const career = document.querySelector<HTMLElement>("[data-career]");
  if (career) {
    if (!("IntersectionObserver" in window)) career.classList.add("on");
    else {
      const io = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          career.classList.add("on");
          io.disconnect();
        },
        { rootMargin: "0px 0px -20% 0px" },
      );
      io.observe(career);
    }
  }
</script>
