---
import Logo from "./Logo.astro";
import { SITE, PAGES, founder, services } from "../data/site";

const year = new Date().getFullYear();
const pages = [...PAGES, { href: "/about/", label: "About" }, { href: "/privacy/", label: "Privacy" }];
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-10">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4 text-sm text-muted">
      <a href="/" class="flex min-h-11 items-center" aria-label={`${SITE.domain}, home`}><Logo /></a>
      <span>{SITE.location.label}</span>
      <nav class="flex flex-wrap gap-x-6 gap-y-1 sm:ml-auto" aria-label="Footer">
        {pages.map((p) => <a href={p.href} class="inline-flex min-h-11 items-center hover:text-navy">{p.label}</a>)}
      </nav>
    </div>

    <nav class="mt-6 border-t border-line pt-5 text-sm text-muted" aria-label="Services">
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {
          services.map((s) => (
            <li>
              <a href={`/services/${s.slug}/`} class="inline-flex min-h-9 items-center hover:text-navy">
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mt-4 flex flex-col-reverse gap-x-8 gap-y-3 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p class="text-[13px]">&copy; {year} {SITE.name}. Founder-led software studio, {SITE.location.label}.</p>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <li>
          <a href={`mailto:${SITE.email}`} class="inline-flex min-h-9 items-center hover:text-navy">{SITE.email}</a>
        </li>
        {
          founder.links.slice(1).map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener" class="inline-flex min-h-9 items-center hover:text-navy">
                {l.label}<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
