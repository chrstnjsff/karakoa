---
// The desktop course is driven by src/scripts/process.ts; without script,
// or with reduced motion, the whole course shows.
import MascotSvg from "../MascotSvg.astro";
import { process, processSection } from "../../data/site";

const route = "M20 110 C 140 30, 240 30, 260 80 S 400 150, 500 90 S 660 20, 740 80 S 900 140, 980 60";
const num = (i: number) => String(i + 1).padStart(2, "0");
---

<section id="process" class="relative overflow-x-clip border-t border-line" aria-labelledby="process-title" data-process>
  <div class="process-pin">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:py-28 lg:flex lg:min-h-screen lg:flex-col lg:justify-center">
      <div class="reveal max-w-2xl">
        <p class="label">{processSection.eyebrow}</p>
        <h2 id="process-title" class="h2 mt-3">{processSection.title}</h2>
        <p class="lead mt-4 max-w-xl">{processSection.lede}</p>
      </div>

      <div class="relative mt-16 hidden lg:block" data-chart>
        <svg viewBox="0 0 1000 160" class="w-full overflow-visible" aria-hidden="true">
          <path
            d={route}
            fill="none"
            stroke="#0b2c44"
            stroke-opacity=".22"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-dasharray="2 7"></path>
          <path data-route d={route} pathLength="1" fill="none" stroke="#d4421f" stroke-width="2" stroke-linecap="round"></path>
          <g data-waypoints></g>
        </svg>
        <div class="invisible absolute top-0 left-0 w-16" data-boat>
          <MascotSvg id="boat" />
        </div>
        <ol class="mt-12 grid grid-cols-5 gap-6">
          {
            process.map((step, i) => (
              <li class="step border-t-2 border-line pt-5" data-step={i}>
                <p class="text-sm font-medium text-coral-700 tabular-nums">{num(i)}</p>
                <h3 class="mt-1 text-lg font-semibold">{step.title}</h3>
                <p class="mt-1 text-sm text-muted">{step.deliverable}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <ol class="mt-10 divide-y divide-line rounded-xl border border-line bg-paper lg:hidden">
        {
          process.map((step, i) => (
            <li class="reveal flex items-baseline gap-4 p-4 sm:p-5">
              <span class="text-sm font-medium text-coral-700 tabular-nums">{num(i)}</span>
              <div>
                <p class="text-[17px] font-semibold text-navy">{step.title}</p>
                <p class="text-sm text-muted">{step.deliverable}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style is:global>
  [data-process][data-pinned] .process-pin {
    position: sticky;
    top: 0;
  }
  .step {
    transition:
      opacity 0.4s ease,
      border-color 0.4s ease;
  }
  [data-waypoints] circle {
    transition:
      fill 0.4s ease,
      stroke-opacity 0.4s ease;
  }
  .js [data-pinned] .step:not(.on) {
    opacity: 0.4;
  }
  .step.on {
    border-top-color: #d4421f;
  }
</style>

<script>
  import "../../scripts/process.ts";
</script>
