---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { SITE, aboutPage, founder, services } from "../data/site";

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE.url}/#founder`,
  name: founder.name,
  jobTitle: founder.role,
  url: founder.links[0].href,
  worksFor: { "@id": `${SITE.url}/#organization` },
  knowsAbout: founder.skills,
  hasCredential: aboutPage.certifications.map((c) => ({ "@type": "EducationalOccupationalCredential", name: c })),
  sameAs: founder.links.slice(1).map((l) => l.href),
};

const aboutLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${SITE.url}/about/#page`,
  url: `${SITE.url}/about/`,
  name: aboutPage.seoTitle,
  isPartOf: { "@id": `${SITE.url}/#website` },
  about: { "@id": `${SITE.url}/#organization` },
};
---

<Base title={aboutPage.seoTitle} description={aboutPage.seoDescription} jsonLd={[aboutLd, personLd]}>
  <article class="mx-auto max-w-6xl px-5 pb-16 sm:px-6 lg:pb-24">
    <header class="max-w-3xl pb-10 pt-12 sm:pt-20">
      <p class="eyebrow">About</p>
      <h1 class="mt-4 text-title1 font-semibold text-ink sm:text-large">{aboutPage.heading}</h1>
      <p class="mt-5 text-callout text-muted">{aboutPage.intro}</p>
    </header>

    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div>
        <section aria-labelledby="name-title">
          <h2 id="name-title" class="text-title2 font-semibold text-ink">Why the name</h2>
          <p class="mt-3 text-body text-muted">{aboutPage.nameStory}</p>
        </section>

        <section class="mt-12" aria-labelledby="how-title">
          <h2 id="how-title" class="text-title2 font-semibold text-ink">How we work</h2>
          <ul class="mt-4 space-y-3">
            {
              aboutPage.howWeWork.map((p) => (
                <li class="flex gap-3 text-body text-muted">
                  <Icon name="check" class="mt-1.5 h-4 w-4 shrink-0 text-teal-text" />
                  <span>{p}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="mt-12" aria-labelledby="services-title">
          <h2 id="services-title" class="text-title2 font-semibold text-ink">What we build</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              services.map((s) => (
                <li>
                  <a href={`/services/${s.slug}/`} class="btn btn-secondary press min-h-10 px-3.5 text-footnote">
                    {s.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <aside class="card self-start p-6 sm:p-8" aria-labelledby="founder-title">
        <p class="eyebrow">{founder.eyebrow}</p>
        <h2 id="founder-title" class="mt-3 text-title3 font-semibold text-ink">{founder.name}</h2>
        <p class="mt-1 text-footnote font-semibold text-accent-text">{founder.role}</p>
        <p class="mt-4 text-body text-muted">{founder.bio}</p>
        <p class="mt-3 text-footnote text-muted">{founder.note}</p>
        <h3 class="eyebrow mt-6">Certifications</h3>
        <ul class="mt-2 space-y-1 text-footnote text-ink">
          {aboutPage.certifications.map((c) => <li>{c}</li>)}
        </ul>
        <h3 class="eyebrow mt-6">Works with</h3>
        <ul class="mt-2 flex flex-wrap gap-2">
          {founder.skills.map((s) => <li class="chip">{s}</li>)}
        </ul>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            founder.links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener" class="btn btn-secondary press min-h-10 px-3.5 text-footnote">
                  <Icon name={l.icon} class="h-4 w-4" />
                  {l.label}
                  <Icon name="external" class="h-3.5 w-3.5 text-muted" />
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>

    <section class="card mt-14 p-6 sm:p-8" aria-labelledby="cta-title">
      <h2 id="cta-title" class="text-title3 font-semibold text-ink">Tell us what you are building</h2>
      <p class="mt-2 text-body text-muted">You get a reply within one working day with a recommended way to start.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/#contact" class="btn btn-primary press">Send an inquiry</a>
        <a href={`mailto:${SITE.email}`} class="btn btn-secondary press">{SITE.email}</a>
      </div>
    </section>
  </article>
</Base>
