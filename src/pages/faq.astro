---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { SITE, calendlyUrl, faq, faqPage } from "../data/site";

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${SITE.url}/faq/#page`,
  url: `${SITE.url}/faq/`,
  isPartOf: { "@id": `${SITE.url}/#website` },
  mainEntity: faq.flatMap((g) =>
    g.items.map((i) => ({
      "@type": "Question",
      name: i.q,
      acceptedAnswer: { "@type": "Answer", text: i.a },
    })),
  ),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
    { "@type": "ListItem", position: 2, name: "FAQ", item: `${SITE.url}/faq/` },
  ],
};
---

<Base title={faqPage.seoTitle} description={faqPage.seoDescription} ogImage="/og/faq.png" jsonLd={[faqLd, breadcrumbLd]}>
  <div class="mx-auto max-w-6xl px-5 pb-16 lg:pb-24">
    <header class="max-w-3xl pt-12 pb-10 sm:pt-20">
      <p class="eyebrow">{faqPage.eyebrow}</p>
      <h1 class="mt-4 text-title2 font-semibold xs:text-title1 sm:text-large">{faqPage.heading}</h1>
      <p class="mt-5 text-callout text-muted">{faqPage.intro}</p>
    </header>

    <div class="grid gap-10 lg:grid-cols-2 lg:gap-x-12">
      {
        faq.map((g, gi) => (
          <section class={`reveal d${(gi % 2) + 1}`} aria-labelledby={`faq-group-${gi}`}>
            <h2 id={`faq-group-${gi}`} class="eyebrow">
              {g.group}
            </h2>
            <div class="mt-3 divide-y divide-line border-y border-line">
              {g.items.map((item) => (
                <details class="disclosure">
                  <summary class="flex min-h-12 items-center justify-between gap-4 py-3 text-copy font-semibold text-navy">
                    <span>{item.q}</span>
                    <svg viewBox="0 0 24 24" fill="none" class="disclosure-chevron h-4 w-4 shrink-0 text-muted" aria-hidden="true">
                      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </summary>
                  <p class="pr-8 pb-4 text-copy text-body">{item.a}</p>
                </details>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <section class="card mt-14 p-6 sm:p-8" aria-labelledby="cta-title">
      <h2 id="cta-title" class="text-title3 font-semibold">Still have a question?</h2>
      <p class="mt-2 text-copy text-muted">Ask it on a free 30-minute call, or send a message and get a reply within one working day.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/#message" class="btn-primary"><Icon name="mail" class="size-4" />Send a message</a>
        <a href={calendlyUrl} target="_blank" rel="noopener" class="btn-ghost">
          <Icon name="calendar" class="size-4" />Book a free call<span class="sr-only"> (opens Calendly in a new tab)</span>
        </a>
      </div>
    </section>
  </div>
</Base>
