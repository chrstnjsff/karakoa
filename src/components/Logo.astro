---
import MascotSvg from "./MascotSvg.astro";

interface Props {
  /** Unique per page; renders the mascot when set. */
  mascotId?: string;
  onDark?: boolean;
}
const { mascotId, onDark = false } = Astro.props;
---

<span class="inline-flex items-center gap-2.5 whitespace-nowrap">
  {
    mascotId && (
      <span class="-mt-1 w-9 shrink-0">
        <MascotSvg id={mascotId} />
      </span>
    )
  }
  <span class:list={["font-semibold tracking-[-0.01em]", onDark ? "text-lg text-white" : "text-base text-navy"]}>
    karakoa<span class:list={["font-normal", onDark ? "text-[#f4704f]" : "text-coral-700"]}>.dev</span>
  </span>
</span>
