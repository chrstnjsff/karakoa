---
// Landing page for the no-JavaScript form path: Web3Forms redirects
// here after a successful submission. Kept out of search and the sitemap.
import Base from "../../layouts/Base.astro";
import { SITE } from "../../data/site";
---

<Base
  title={`Inquiry sent · ${SITE.name}`}
  description="Your inquiry was sent. Thanks for getting in touch."
  noindex
>
  <div class="mx-auto max-w-2xl px-5 pb-16 sm:px-6">
    <header class="pb-10 pt-14 sm:pt-20">
      <p class="reveal eyebrow">Sent</p>
      <h1 class="reveal d1 mt-4 text-title2 font-semibold text-ink xs:text-title1 sm:text-large">Inquiry sent</h1>
      <p class="reveal d2 mt-4 max-w-xl text-callout text-muted">
        Thanks for reaching out. We reply to the email address you gave within one working day.
      </p>
      <div class="reveal d3 mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary press">Back to home</a>
        <a href="/#services" class="btn btn-secondary press">See the services</a>
      </div>
    </header>
  </div>
</Base>
