---
import Icon from "../Icon.astro";
import PricingArt from "../PricingArt.astro";
import { packages, pricingSection } from "../../data/site";

const { title, mark } = pricingSection;
const at = title.indexOf(mark);
---

<section id="pricing" class="relative border-t border-line" aria-labelledby="pricing-title">
  <svg class="pk-hills pointer-events-none absolute inset-x-0 bottom-0 h-16 w-full sm:h-20 lg:h-24" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 40C160 22 300 20 460 34S760 60 940 42 1260 16 1440 32V80H0Z" fill="#b7d0d2" opacity=".4" />
    <path d="M0 60C180 48 340 46 520 56S860 74 1040 58 1320 44 1440 54V80H0Z" fill="#b7d0d2" opacity=".55" />
  </svg>
  <div class="relative mx-auto max-w-6xl px-5 pt-24 pb-28 sm:pt-32 sm:pb-36 lg:pb-40">
    <svg class="pk-spark pointer-events-none absolute top-24 right-12 hidden size-4 md:block" viewBox="-5 -5 10 10" aria-hidden="true">
      <path d="M0-5 1.2-1.2 5 0 1.2 1.2 0 5-1.2 1.2-5 0-1.2-1.2z" fill="#e3a75b" />
    </svg>
    <svg class="pk-spark pointer-events-none absolute top-48 right-56 hidden size-2.5 lg:block" viewBox="-5 -5 10 10" aria-hidden="true">
      <path d="M0-5 1.2-1.2 5 0 1.2 1.2 0 5-1.2 1.2-5 0-1.2-1.2z" fill="#f4d58d" />
    </svg>

    <div class="reveal">
      <p class="label">{pricingSection.eyebrow}</p>
      <h2 id="pricing-title" class="h2 mt-3 max-w-2xl lg:max-w-none">
        {title.slice(0, at)}<span class="pk-mark"
          >{mark}<svg viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true"
            ><path d="M3 9.5C70 4.5 160 3 297 6.5" pathLength="1"></path><path d="M40 12C110 9 200 8.5 270 10" pathLength="1"
            ></path></svg
          ></span
        >{title.slice(at + mark.length)}
      </h2>
      <p class="lead mt-4 max-w-xl lg:max-w-3xl">{pricingSection.lede}</p>
    </div>

    <div class="mt-12 grid gap-x-5 gap-y-8 sm:grid-cols-2 lg:mt-14 xl:grid-cols-4">
      {
        packages.map((p) => (
          <article class="reveal flex" aria-labelledby={`pk-${p.id}`}>
            <div class:list={["pk-card", { "pk-feat": p.badge }]}>
              {p.badge && <p class="pk-badge">{p.badge}</p>}
              <div class="pk-art" data-loop>
                <PricingArt id={p.id} />
              </div>
              <div class="flex flex-1 flex-col px-5 pt-4 pb-6">
                <h3 id={`pk-${p.id}`} class="flex items-center gap-3 text-[21px] leading-tight font-semibold tracking-[-0.01em]">
                  <span class="pk-ico">
                    <Icon name={p.icon} class="size-5" />
                  </span>
                  {p.name}
                </h3>
                <p class="mt-3 text-[15px] leading-relaxed">{p.tagline}</p>
                <ul class="mt-4 mb-7 space-y-2 text-[15px]">
                  {p.meta.map((m) => (
                    <li class="flex items-center gap-2.5">
                      <Icon name={m.icon} class="size-[18px] shrink-0 text-navy/70" />
                      {m.text}
                    </li>
                  ))}
                </ul>
                <a
                  href="#message"
                  data-msg
                  data-type={p.formType}
                  class:list={["pk-cta mt-auto", p.badge ? "btn-primary w-full justify-between" : "btn-link min-h-11 self-start"]}
                >
                  {p.cta} <Icon name="arrow" class="size-4" />
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-12 flex flex-col gap-8 border-t border-line pt-10 xl:flex-row xl:items-center xl:gap-6">
      <div class="flex items-center gap-4 xl:max-w-[16rem] xl:shrink-0">
        <span class="pk-tile size-12 rounded-xl">
          <Icon name="coins" class="size-6" />
        </span>
        <p class="text-[15px] leading-relaxed">{pricingSection.note}</p>
      </div>
      <span class="hidden h-12 w-px shrink-0 bg-line xl:block" aria-hidden="true"></span>
      <ol class="grid flex-1 grid-cols-1 gap-x-6 gap-y-5 xs:grid-cols-2 lg:grid-cols-4 xl:flex xl:justify-between xl:gap-3" aria-label="How a project runs">
        {
          pricingSection.steps.map((s, i) => (
            <li class="flex items-start gap-2.5">
              <span class="pk-tile size-9 rounded-lg">
                <Icon name={s.icon} class="size-[18px]" />
              </span>
              <span class="min-w-0">
                <span class="block text-[15px] font-semibold text-navy">{s.name}</span>
                <span class="block text-[13px] leading-snug text-muted xl:whitespace-nowrap">{s.text}</span>
              </span>
              {i < pricingSection.steps.length - 1 && (
                <svg viewBox="0 0 24 24" class="ml-auto hidden size-3.5 shrink-0 self-center text-navy/40 lg:block xl:ml-2" aria-hidden="true">
                  <path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .pk-card {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: var(--color-paper);
    box-shadow: 0 1px 2px rgba(11, 44, 68, 0.04);
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.35s,
      box-shadow 0.35s;
  }
  .pk-feat {
    border: 2px solid var(--color-coral);
    box-shadow: 0 10px 30px -14px rgba(212, 66, 31, 0.35);
  }
  .pk-badge {
    position: absolute;
    top: -13px;
    right: 18px;
    z-index: 1;
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--color-coral-600);
    font-size: 13px;
    font-weight: 500;
    line-height: 20px;
    color: #fff;
  }
  .pk-art {
    margin: 7px 7px 0;
    overflow: hidden;
    border-radius: 11px 11px 0 0;
  }
  .pk-feat .pk-art {
    margin: 6px 6px 0;
  }
  .pk-ico,
  .pk-tile {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    background: #fbeee6;
    color: var(--color-coral-700);
  }
  .pk-ico {
    width: 40px;
    height: 40px;
    border-radius: 10px;
  }
  .pk-feat .pk-ico {
    background: var(--color-coral-600);
    color: #fff;
  }
  .pk-cta :global(svg) {
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .pk-cta:hover :global(svg) {
    transform: translateX(3px);
  }
  @media (hover: hover) {
    .pk-card:hover {
      transform: translateY(-4px);
      border-color: rgba(11, 44, 68, 0.28);
      box-shadow: 0 14px 30px -18px rgba(11, 44, 68, 0.35);
    }
    .pk-feat:hover {
      border-color: var(--color-coral-600);
      box-shadow: 0 16px 34px -16px rgba(212, 66, 31, 0.45);
    }
  }

  /* Low hills along the foot of the section; they fade into the page below */
  .pk-hills {
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }

  /* The underline draws in when the heading arrives */
  .pk-mark {
    position: relative;
    white-space: nowrap;
  }
  .pk-mark svg {
    position: absolute;
    bottom: -0.16em;
    left: -2%;
    width: 104%;
    height: 0.3em;
    overflow: visible;
    fill: none;
    stroke: var(--color-coral);
    stroke-linecap: round;
  }
  .pk-mark path {
    stroke-width: 3.5;
    stroke-dasharray: 1;
    transition: stroke-dashoffset 0.8s cubic-bezier(0.45, 0, 0.25, 1) 0.35s;
  }
  .pk-mark path + path {
    stroke-width: 2;
    opacity: 0.45;
    transition-delay: 0.6s;
  }
  :global(.js) .reveal:not(:global(.in)) .pk-mark path {
    stroke-dashoffset: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .pk-card,
    .pk-cta :global(svg),
    .pk-mark path {
      transition: none;
    }
    .pk-card:hover,
    .pk-cta:hover :global(svg) {
      transform: none;
    }
  }
</style>
